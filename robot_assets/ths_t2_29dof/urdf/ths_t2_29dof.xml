  <actuator>
    <!--      电机名称    关联的关节名称                    减速比                 控制范围               是否限制控制输入 -->
    <!-- 左腿 -->
    <motor name="lhpj" joint="left_hip_pitch_joint" gear="1.00" ctrlrange="-130 130" ctrllimited="true" forcelimited= "true" forcerange="-130 130"/>
    <motor name="lhrj" joint="left_hip_roll_joint" gear="1.00" ctrlrange="-130 130" ctrllimited="true" forcelimited= "true" forcerange="-130 130"/>
    <motor name="lhyj" joint="left_hip_yaw_joint" gear="1.00" ctrlrange="-130 130" ctrllimited="true" forcelimited= "true" forcerange="-45 45"/>
    <motor name="lkj" joint="left_knee_joint" gear="1.00" ctrlrange="-130 130" ctrllimited="true" forcelimited= "true" forcerange="-130 130"/>
    <motor name="lapj" joint="left_ankle_pitch_joint" gear="1.00" ctrlrange="-130 130" ctrllimited="true" forcelimited= "true" forcerange="-35 35"/>
    <motor name="larj" joint="left_ankle_roll_joint" gear="1.00" ctrlrange="-130 130" ctrllimited="true" forcelimited= "true" forcerange="-12 12"/>

    <!-- 右腿 -->
    <motor name="rhpj" joint="right_hip_pitch_joint" gear="1.00" ctrlrange="-130 130" ctrllimited="true" forcelimited= "true" forcerange="-130 130"/>
    <motor name="rhrj" joint="right_hip_roll_joint" gear="1.00" ctrlrange="-130 130" ctrllimited="true" forcelimited= "true" forcerange="-130 130"/>
    <motor name="rhyj" joint="right_hip_yaw_joint" gear="1.00" ctrlrange="-45 45" ctrllimited="true" forcelimited= "true" forcerange="-45 45"/>
    <motor name="rkj" joint="right_knee_joint" gear="1.00" ctrlrange="-130 130" ctrllimited="true" forcelimited= "true" forcerange="-130 130"/>
    <motor name="rapj" joint="right_ankle_pitch_joint" gear="1.00" ctrlrange="-35 35" ctrllimited="true" forcelimited= "true" forcerange="-35 35"/>
    <motor name="rarj" joint="right_ankle_roll_joint" gear="1.00" ctrlrange="-12 12" ctrllimited="true" forcelimited= "true" forcerange="-12 12"/>

    <!-- 躯干 -->
    <motor name="wyj" joint="waist_yaw_joint" gear="1.00" ctrlrange="-35 35" ctrllimited="true" forcelimited= "true" forcerange="-35 35"/>
    <motor name="wpj" joint="waist_pitch_joint" gear="1.00" ctrlrange="-75 75" ctrllimited="true" forcelimited= "true" forcerange="-75 75"/>
    <motor name="wrj" joint="waist_roll_joint" gear="1.00" ctrlrange="-75 75" ctrllimited="true" forcelimited= "true" forcerange="-75 75"/>

    <!-- 头部 -->
