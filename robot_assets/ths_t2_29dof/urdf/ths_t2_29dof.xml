    <motor name="hpj" joint="head_pitch_joint" gear="1.00" ctrlrange="-12 12" ctrllimited="true" forcelimited= "true" forcerange="-12 12"/>

    <!-- 左手臂 -->
    <motor name="lspj" joint="left_shoulder_pitch_joint" gear="1.00" ctrlrange="-36 36" ctrllimited="true" forcelimited= "true" forcerange="-36 36"/>
    <motor name="lsrj" joint="left_shoulder_roll_joint" gear="1.00" ctrlrange="-36 36" ctrllimited="true" forcelimited= "true" forcerange="-36 36"/>
    <motor name="lsyj" joint="left_shoulder_yaw_joint" gear="1.00" ctrlrange="-36 36" ctrllimited="true" forcelimited= "true" forcerange="-36 36"/>
    <motor name="lej" joint="left_elbow_joint" gear="1.00" ctrlrange="-36 36" ctrllimited="true" forcelimited= "true" forcerange="-36 36"/>
    <motor name="lwrj" joint="left_wrist_roll_joint" gear="1.00" ctrlrange="-36 36" ctrllimited="true" forcelimited= "true" forcerange="-36 36"/>
    <motor name="lwpj" joint="left_wrist_pitch_joint" gear="1.00" ctrlrange="-12 12" ctrllimited="true" forcelimited= "true" forcerange="-12 12"/>
     
    <!-- 右手臂 -->
    <motor name="rspj" joint="right_shoulder_pitch_joint" gear="1.00" ctrlrange="-36 36" ctrllimited="true" forcelimited= "true" forcerange="-36 36"/>
    <motor name="rsrj" joint="right_shoulder_roll_joint" gear="1.00" ctrlrange="-36 36" ctrllimited="true" forcelimited= "true" forcerange="-36 36"/>
    <motor name="rsyj" joint="right_shoulder_yaw_joint" gear="1.00" ctrlrange="-36 36" ctrllimited="true" forcelimited= "true" forcerange="-36 36"/>
    <motor name="rej" joint="right_elbow_joint" gear="1.00" ctrlrange="-36 36" ctrllimited="true" forcelimited= "true" forcerange="-36 36"/>
    <motor name="rwrj" joint="right_wrist_roll_joint" gear="1.00" ctrlrange="-36 36" ctrllimited="true" forcelimited= "true" forcerange="-36 36"/>
    <motor name="rwrp" joint="right_wrist_pitch_joint" gear="1.00" ctrlrange="-12 12" ctrllimited="true" forcelimited= "true" forcerange="-12 12"/>
    
